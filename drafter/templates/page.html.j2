<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pack drafter</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="bar">
  <div class="bar-in">
    <img class="mark" src="/favicon.svg" alt="" width="28" height="28">
    <div>
      <div class="bar-title">Pack drafter</div>
      <div class="bar-sub">Threats signalled in the last {{ days }} days, since {{ since }}</div>
    </div>
  </div>
</header>
<main>
{% if error %}
  <p class="banner banner-error" role="alert">{{ error }}</p>
{% endif %}
{% if notes %}
  <section class="banner banner-warn">
    <strong>Feeds needing a look</strong> (the list may be missing threats):
    <ul>{% for note in notes %}<li>{{ note }}</li>{% endfor %}</ul>
    <code>drafter feeds status</code> says more.
  </section>
{% endif %}

<nav class="summary" aria-label="Sections">
{% for s in sections %}
  <a href="#{{ s.kind }}"><span class="count">{{ s.cards|length }}</span> {{ s.title }}{% if s.open %} <span class="pill pill-open">{{ s.open }} to decide</span>{% endif %}</a>
{% endfor %}
  <a href="#history"><span class="count">{{ history|length }}</span> Decisions</a>
</nav>

{% for s in sections %}
<section class="section" id="{{ s.kind }}">
  <h2>{{ s.title }} <span class="quiet">{{ s.cards|length }} threat(s), {{ s.cves }} CVE(s)</span></h2>
  <p class="blurb">{{ s.blurb }}</p>
  {% if not s.cards %}<p class="empty">None.</p>{% endif %}
  {% for c in s.cards %}
  {% set st = c.state %}
  <article class="card{% if c.decidable %} card-{{ st.word }}{% endif %}" id="{{ c.anchor }}">
    <div class="card-head">
      <h3>{{ c.name }}</h3>
      <span class="date">first signalled {{ c.first }}</span>
      {% if c.decidable %}
        {% if st.word == "approve" %}<span class="pill pill-approve">Approved</span>
        {% elif st.word == "reject" %}<span class="pill pill-reject">Rejected</span>
        {% elif st.word == "again" %}<span class="pill pill-again">Look again</span>
        {% else %}<span class="pill pill-open">Undecided</span>{% endif %}
      {% endif %}
    </div>
    <p class="cves">{% for cve in c.cves %}<a href="https://nvd.nist.gov/vuln/detail/{{ cve }}" rel="noreferrer noopener" target="_blank">{{ cve }}</a>{% endfor %}</p>
    <dl>
      <dt>Signals</dt><dd>{{ c.signals|join("; ") }}</dd>
      {% if c.kind == "judge" and c.packages %}<dt>Packages</dt><dd>{{ c.packages }}</dd>{% endif %}
      {% if c.kind == "thirdparty" %}
        <dt>Matched</dt><dd>{{ c.matched|join("; ") or "NVD names the product" }}</dd>
        <dt>Named</dt><dd>{{ c.named|join(", ") or "no product yet" }}</dd>
      {% endif %}
      {% if c.repos %}<dt>{{ "Rebuilt by" if c.kind == "thirdparty" else "Also rebuilt by" }}</dt><dd>{{ c.repos|join("; ") }}</dd>{% endif %}
      {% if c.kind == "setaside" %}<dt>Why</dt><dd>{{ c.reasons|join("; ") }}</dd>{% endif %}
    </dl>
    {% if c.decidable %}
      {% if st.decision %}
      {% set d = st.decision %}
      <p class="decided">
        {{ "Approved" if d.verdict == "approve" else "Rejected" }} {{ d.decided_at[:16]|replace("T", " ") }} UTC by {{ d.decided_by }}:
        <q>{{ d.reason }}</q>
        {% if st.new %}<br><strong>Came after it:</strong> {{ st.new|join(", ") }}{% endif %}
        {% if st.apart %}<br><strong>Decided apart:</strong> {{ st.apart|join(", ") }}{% endif %}
      </p>
      {% endif %}
      {% set keep = kept.reason if kept.anchor == c.anchor else "" %}
      {% if st.open %}
      <form class="decide" method="post" action="/decide">
      {% else %}
      <details{% if keep %} open{% endif %}><summary>Decide again</summary>
      <form class="decide" method="post" action="/decide">
      {% endif %}
        <input type="hidden" name="token" value="{{ token }}">
        <input type="hidden" name="kind" value="{{ c.kind }}">
        <input type="hidden" name="cves" value="{{ c.cves|join(',') }}">
        <label for="r-{{ c.anchor }}">Reason</label>
        <textarea id="r-{{ c.anchor }}" name="reason" rows="2" maxlength="1000" required>{{ keep }}</textarea>
        <div class="buttons">
          <button type="submit" name="verdict" value="approve" class="btn btn-approve">Approve</button>
          <button type="submit" name="verdict" value="reject" class="btn btn-reject">Reject</button>
        </div>
      </form>
      {% if not st.open %}</details>{% endif %}
    {% endif %}
  </article>
  {% endfor %}
</section>
{% endfor %}

<section class="section" id="others">
  <h2>Not threats here yet</h2>
  {% if unnamed %}
  <p>No vendor package, and NVD names no product yet ({{ unnamed|length }}); not ruled out until NVD names one:</p>
  <ul class="plain">
    {% for c in unnamed %}<li><span class="date">{{ c.first[:10] }}</span> <a href="https://nvd.nist.gov/vuln/detail/{{ c.cve }}" rel="noreferrer noopener" target="_blank">{{ c.cve }}</a>{% if c.kev_name %} · CISA: {{ c.kev_name }}{% endif %}</li>{% endfor %}
  </ul>
  {% endif %}
  <p>Not on a supported release: {{ elsewhere }} CVE(s), counted only (<code>drafter candidates list --all</code> lists them).</p>
  {% if unread %}<p>Vendor records not read yet: {{ unread|length }} CVE(s): {{ unread|join(", ") }}.</p>{% endif %}
</section>

<section class="section" id="history">
  <h2>Decisions <span class="quiet">newest first; kept, never changed</span></h2>
  {% if not history %}<p class="empty">None yet.</p>{% else %}
  <div class="table-wrap">
  <table>
    <thead><tr><th>When (UTC)</th><th>Verdict</th><th>Threat</th><th>Reason</th><th>By</th></tr></thead>
    <tbody>
    {% for d in history %}
      <tr>
        <td class="nowrap">{{ d.decided_at[:16]|replace("T", " ") }}</td>
        <td><span class="pill pill-{{ d.verdict }}">{{ "Approved" if d.verdict == "approve" else "Rejected" }}</span></td>
        <td>{{ d.families|join(", ") or "?" }}<br><span class="quiet">{{ d.cves|join(", ") }}</span></td>
        <td>{{ d.reason }}</td>
        <td>{{ d.decided_by }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
</section>
</main>
<footer>pack drafter {{ version }} · AGPL-3.0 · a NouriLoop LLC project</footer>
</body>
</html>
